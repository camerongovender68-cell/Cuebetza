# Copy this file to .env and fill in your own Supabase project's values.
# Find these at supabase.com -> your project -> Project Settings -> API.
# The anon/public key is safe to ship in the client; access is controlled
# by Row Level Security policies on each table, not by keeping this secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
